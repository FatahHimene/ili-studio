# Copy to /root/ili-backup/backup.env, fill in, then: chmod 600 /root/ili-backup/backup.env
# Cloudflare R2 (R2 > Manage API tokens, Object Read & Write on bucket ilidweb-backups only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# s3:<R2 endpoint>/<bucket>, e.g. s3:https://0123456789abcdef.r2.cloudflarestorage.com/ilidweb-backups
RESTIC_REPOSITORY=
# Encryption password of the backups. KEEP IT IN YOUR PASSWORD MANAGER: without it, backups can never be read.
RESTIC_PASSWORD=
# Optional: https://healthchecks.io ping URL, to get an e-mail when a backup fails or does not run
HEALTHCHECK_URL=
